# =====================================================================
# Backend Tablerillos — variables de entorno
# Copia a .env (o usa el .env de la raíz vía docker-compose).
# =====================================================================

# ----- App -----
ENVIRONMENT=development
DEBUG=true

# Auth: SIEMPRE Minerva (OIDC + minerva-sdk). No hay proveedor alternativo ni
# modo "sin auth"; en tests se sustituye con dependency_overrides.

# ----- Base de datos (metadata de Tablerillos) -----
DATABASE_URL=postgresql+psycopg://tablerillos:change-me-postgres@localhost:5432/tablerillos

# ----- Redis (sesiones BFF, caché, colas) -----
REDIS_URL=redis://localhost:6379/0

# ----- Cifrado de credenciales de conexiones (Fernet) -----
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# ----- Sesión BFF -----
SESSION_COOKIE_NAME=tb_session
SESSION_SECRET=change-me-session-secret
SESSION_TTL_SECONDS=86400

# ----- Minerva: SDK (backend → Minerva, server-to-server) -----
MINERVA_ISSUER_URL=http://localhost:9000
MINERVA_APPLICATION_CODE=tablerillos
MINERVA_EXPECTED_ISSUER=http://localhost:9000
MINERVA_VERIFY_AUD=true
MINERVA_JWKS_CACHE_TTL=3600
MINERVA_PERMISSIONS_CACHE_TTL=300

# ----- Minerva: OIDC / BFF -----
MINERVA_PUBLIC_ISSUER_URL=http://localhost:9000
MINERVA_CLIENT_ID=
MINERVA_CLIENT_SECRET=
MINERVA_REDIRECT_URI=http://localhost:8000/api/auth/callback
MINERVA_SCOPES=openid profile email
FRONTEND_POST_LOGIN_URL=http://localhost:5173/admin

# ----- CORS -----
CORS_ALLOW_ORIGINS=http://localhost:5173
