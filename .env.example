# =====================================================================
# Tablerillos — variables compartidas para docker-compose (raíz)
# Copia este archivo a .env y ajusta los valores. NO commitees .env.
# =====================================================================

# ----- PostgreSQL (base de metadata de Tablerillos) -----
POSTGRES_USER=tablerillos
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=tablerillos
POSTGRES_PORT=5432

# ----- Redis (sesiones BFF, caché de datasets, cola de export) -----
REDIS_PORT=6379

# ----- Puertos expuestos -----
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Producción: único puerto del stack (nginx). Ver infra/docker-compose.prod.yml.
HTTP_PORT=8080

# ----- Aplicación (las lee el backend vía env_file) -----
# En producción config.py RECHAZA arrancar con DEBUG=true, credenciales
# "change-me" o SECRET_ENCRYPTION_KEY vacía (_reject_insecure_production).
ENVIRONMENT=development
DEBUG=true

# Clave Fernet para cifrar las contraseñas de las conexiones a BD externas.
# OBLIGATORIA en producción; genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si se pierde, las credenciales de todas las conexiones quedan indescifrables.
SECRET_ENCRYPTION_KEY=

# Sesión BFF (cookie tb_session respaldada en Redis).
SESSION_TTL_SECONDS=86400

# Orígenes permitidos para CORS (solo necesario si el frontend se sirve desde
# otro origen; con el nginx de producción todo es same-origin).
CORS_ALLOW_ORIGINS=http://localhost:5173

# ----- IA (generación asistida de SQL y ChartSpec) -----
# API key de OpenAI: vive SOLO aquí/en el entorno; nunca se envía al frontend ni
# se registra en logs. Si queda vacía, el módulo de IA responde 503.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Timeout duro (segundos) de la llamada al LLM y tope de caracteres del prompt.
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_PROMPT_CHARS=4000

# A dónde redirige el backend tras completar el login OIDC.
FRONTEND_POST_LOGIN_URL=http://localhost:5173/admin

# Scopes OIDC solicitados a Minerva.
MINERVA_SCOPES=openid profile email

# ----- PAT de GitHub (instalación del minerva-sdk privado en el build) -----
# OBLIGATORIO: el minerva-sdk es dependencia base y vive en un repo privado.
# Token de acceso personal con permiso de lectura al repo del SDK. El build falla
# si va vacío. compose lo lee del ENTORNO del shell, no de este archivo; antes de
# construir:  set -a && . ./.env && set +a && docker compose ... build
GITHUB_TOKEN=

# ----- Minerva (IdP institucional del IIEG) -----
# Minerva es OBLIGATORIO: única fuente de login, usuarios, roles y permisos.
# Corre FUERA de este compose, en la máquina host (localhost:9000).
# Hay DOS perspectivas de URL hacia Minerva:
#   - PUBLIC: la que usa el NAVEGADOR para el redirect a /auth/authorize.
#   - ISSUER: la que usa el BACKEND (canje de token + descarga de JWKS).
# Desde un contenedor, "localhost" NO es el host: usar host.docker.internal.
MINERVA_PUBLIC_ISSUER_URL=http://localhost:9000
MINERVA_ISSUER_URL=http://host.docker.internal:9000
MINERVA_APPLICATION_CODE=tablerillos

# Credenciales del cliente confidencial (las devuelve Minerva al importar el
# manifest o al registrar la app). NUNCA commitear los valores reales.
MINERVA_CLIENT_ID=
MINERVA_CLIENT_SECRET=
MINERVA_REDIRECT_URI=http://localhost:8000/api/auth/callback
